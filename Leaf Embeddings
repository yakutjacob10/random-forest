import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import TensorDataset, DataLoader
from sklearn.datasets import load_breast_cancer
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.preprocessing import OneHotEncoder

# 1. تحميل البيانات من المرجع وتقسيمها
data = load_breast_cancer()
X_train, X_test, y_train, y_test = train_test_split(
    data.data, data.target, test_size=0.2, random_state=42
)

# 2. تدريب Random Forest واستخراج تمثيل الأوراق (Leaf Indices)
rf = RandomForestClassifier(n_estimators=50, max_depth=4, random_state=42)
rf.fit(X_train, y_train)

# تحويل أرقام الأوراق إلى تمثيل ثنائي (One-Hot) لتعمل كمدخلات قابلة للاشتقاق
encoder = OneHotEncoder(handle_unknown='ignore', sparse_output=False)
X_train_rf = encoder.fit_transform(rf.apply(X_train))
X_test_rf = encoder.transform(rf.apply(X_test))

# تحويل البيانات إلى Tensors
X_train_t = torch.tensor(X_train_rf, dtype=torch.float32)
y_train_t = torch.tensor(y_train, dtype=torch.float32).unsqueeze(1)
X_test_t = torch.tensor(X_test_rf, dtype=torch.float32)
y_test_t = torch.tensor(y_test, dtype=torch.float32).unsqueeze(1)

# دالة مساعدة لإنشاء النموذج وحساب الدقة
def create_model():
    return nn.Sequential(
        nn.Linear(X_train_t.shape[1], 1),
        nn.Sigmoid()
    )

def evaluate(model, name):
    with torch.no_grad():
        preds = (model(X_test_t) > 0.5).float()
        acc = (preds == y_test_t).float().mean().item()
        print(f"[{name}] Test Accuracy: {acc * 100:.2f}%")
